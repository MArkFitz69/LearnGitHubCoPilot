[Unit]
Description=Sensor Data Web API Server
After=network.target zigbee-sensor-reader.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/LearnGitHubCoPilot
ExecStart=/home/admin/LearnGitHubCoPilot/.venv/bin/python -m zigbee_sensor_reader --serve --port 8080
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
